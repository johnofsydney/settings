            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "\"$HOME/Projects/John/settings/claude/hooks/temp-marker-guard.sh\"",
            "timeout": 15,
            "statusMessage": "Checking for TEMP-marked files"
          },
          {
            "type": "command",
            "if": "Bash(gh *)",
            "command": "\"$HOME/Projects/John/settings/claude/hooks/temp-marker-guard.sh\"",
            "timeout": 15,
            "statusMessage": "Checking for TEMP-marked files"
          }
        ]
      },
      {
