{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(gh search:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr status:*)",
      "Bash(scratch-clean:*)",
      "mcp__claude_ai_Slack__slack_search_public_and_private",
      "mcp__claude_ai_Gmail__search_threads",
      "mcp__claude_ai_Google_Drive__search_files",
      "mcp__claude_ai_Google_Calendar__list_events",
      "mcp__claude_ai_Linear__get_issue",
      "mcp__claude_ai_Google_Drive__read_file_content",
      "mcp__claude_ai_Slack__slack_read_channel",
      "mcp__claude_ai_Notion__notion-search",
      "mcp__claude_ai_Gmail__get_thread",
      "mcp__claude_ai_Linear__list_issues",
      "mcp__claude_ai_Slack__slack_search_users",
      "mcp__claude_ai_Linear__list_comments",
      "mcp__claude_ai_Notion__notion-fetch",
      "mcp__claude_ai_Slack__slack_read_file",
      "mcp__claude_ai_Notion__notion-query-meeting-notes",
      "mcp__claude_ai_Slack__slack_read_thread",
      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(gh pr create)",
      "Bash(gh pr create *)"
    ],
    "deny": [
      "Bash(git merge:*)",
      "Bash(rm:*)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git branch -D *)",
      "Bash(git branch --delete --force *)",
      "Bash(git worktree remove *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh run cancel *)",
      "Bash(gh run delete *)",
      "Bash(gh release create *)",
      "Bash(gh release delete *)",
      "Bash(gh release edit *)",
      "Bash(gh release upload *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl apply *)",
      "Bash(bin/rails db:reset)",
      "Bash(bin/rails db:reset *)",
      "Bash(bin/rails db:drop)",
      "Bash(bin/rails db:drop *)",
      "Bash(gem uninstall *)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.zsh_history)",
      "Read(~/.bash_history)"
    ],
    "ask": [],
    "defaultMode": "auto"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -z \"${HOME-}\" ]; then { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; else case \"${OSTYPE-}\" in msys*|cygwin*|win32*) if [ -f \"$HOME/.orca/agent-hooks/claude-hook.cmd\" ]; then case \"$HOME\" in *\\&*|*\\^*|*\\(*|*\\)*|*\\;*|*,*|*=*|*%*|*\\!*) if [ -f \"$SYSTEMROOT/System32/WindowsPowerShell/v1.0/powershell.exe\" ]; then \"$SYSTEMROOT/System32/WindowsPowerShell/v1.0/powershell.exe\" -NoProfile -ExecutionPolicy Bypass -EncodedCommand ; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi ;; *) \"$HOME/.orca/agent-hooks/claude-hook.cmd\" ;; esac; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi ;; *) if [ -f \"$HOME/.orca/agent-hooks/claude-hook.sh\" ] && [ -r \"$HOME/.orca/agent-hooks/claude-hook.sh\" ] && [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi ;; esac; fi",
            "timeout": 10
          }
        ]
      }
    ],
