{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(gh pr create)",
      "Bash(gh pr create:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(gh search:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr status:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(scratch-clean:*)",
      "mcp__claude_ai_Slack__slack_search_public_and_private",
      "mcp__claude_ai_Gmail__search_threads",
      "mcp__claude_ai_Google_Drive__search_files",
      "mcp__claude_ai_Google_Calendar__list_events",
      "mcp__claude_ai_Linear__get_issue",
      "mcp__claude_ai_Google_Drive__read_file_content",
      "mcp__claude_ai_Slack__slack_read_channel",
      "mcp__claude_ai_Notion__notion-search",
      "mcp__claude_ai_Gmail__get_thread",
      "mcp__claude_ai_Linear__list_issues",
      "mcp__claude_ai_Slack__slack_search_users",
      "mcp__claude_ai_Linear__list_comments",
      "mcp__claude_ai_Notion__notion-fetch",
      "mcp__claude_ai_Slack__slack_read_file",
      "mcp__claude_ai_Notion__notion-query-meeting-notes",
      "mcp__claude_ai_Slack__slack_read_thread"
    ],
    "deny": [
      "Bash(git merge:*)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(rm:*)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git branch -D *)",
      "Bash(git branch --delete --force *)",
      "Bash(git worktree remove *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr review --approve*)",
      "Bash(gh pr review --request-changes*)",
      "Bash(gh run cancel *)",
      "Bash(gh run delete *)",
      "Bash(gh release create *)",
      "Bash(gh release delete *)",
      "Bash(gh release edit *)",
      "Bash(gh release upload *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl apply *)",
      "Bash(bin/rails db:reset)",
      "Bash(bin/rails db:reset *)",
      "Bash(bin/rails db:drop)",
      "Bash(bin/rails db:drop *)",
      "Bash(gem uninstall *)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.zsh_history)",
      "Read(~/.bash_history)"
    ],
    "ask": [],
    "defaultMode": "auto"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/john.coote/.orca/agent-hooks/claude-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/john.coote/.orca/agent-hooks/claude-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/john.coote/.orca/agent-hooks/claude-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/john.coote/.orca/agent-hooks/claude-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/john.coote/.orca/agent-hooks/claude-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/john.coote/.orca/agent-hooks/claude-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/john.coote/.orca/agent-hooks/claude-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/Projects/John/settings/claude/hooks/temp-marker-guard.sh\"",
            "if": "Bash(git *)",
            "timeout": 15,
            "statusMessage": "Checking for TEMP-marked files"
          },
          {
            "type": "command",
            "command": "\"$HOME/Projects/John/settings/claude/hooks/temp-marker-guard.sh\"",
            "if": "Bash(gh *)",
            "timeout": 15,
            "statusMessage": "Checking for TEMP-marked files"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/john.coote/.orca/agent-hooks/claude-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/john.coote/.orca/agent-hooks/claude-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/john.coote/.orca/agent-hooks/claude-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/john.coote/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/john.coote/.orca/agent-hooks/claude-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "if [ -f '/Users/john.coote/.orca/agent-hooks/claude-statusline.sh' ] && [ -r '/Users/john.coote/.orca/agent-hooks/claude-statusline.sh' ] && [ -x '/Users/john.coote/.orca/agent-hooks/claude-statusline.sh' ]; then /bin/sh '/Users/john.coote/.orca/agent-hooks/claude-statusline.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi"
  },
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true,
    "ruby-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    }
  },
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "theme": "dark",
  "autoCompactEnabled": true,
  "autoMode": {
    "classifyAllShell": true,
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Primary use of Claude Code**: software development",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: PUBLIC — github.com:johnofsydney/settings (repo: johnofsydney/settings) — any push here is publishing",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: Default branch is `master`; no protected branches or rulesets listed via gh (public repo — treat pushes to `master` as publishing regardless)",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Source control**: The trusted repo (github.com:johnofsydney/settings, public) and its remote(s) only — no additional orgs configured",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar — note this repo is public, so secrets must never be committed here even though repo content itself is public (per CLAUDE.md: real secrets belong only in gitignored `env_variables.sh` / `work_aliases.sh`, never committed)",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment (hyphen/underscore/dot-delimited — e.g. matches `prod-db`, not `producer`)",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development (personal dotfiles/Mac-setup maintenance in this repo)",
      "**Trusted repo**: /Users/john.coote/Projects/John/settings and its remote github.com:johnofsydney/settings.git (public — since this repo is public, only this repo's own work belongs in commits/pushes here; content ported or first read from outside this session's repo is not its own work; secrets are never cleared into it regardless of visibility, per repo convention that real secrets stay in gitignored `env_variables.sh` / `work_aliases.sh`)",
      "**Org-specific CLIs**: None configured",
      "routine under bin/ prefix: repo-local helper scripts (worktree, dcop, dspec, backup-local-db, delete-finished-branches, scratch-clean) are this repo's own tooling, callable bare via PATH"
    ]
  },
  "voiceEnabled": false
}
