env_variables.sh

# This repo's own Claude Code local settings — machine-specific, never shared.
# Not to be confused with claude/, which IS the shared config (see claude/README.md).
.claude/settings.local.json

# Work-machine Claude context: internal team/project names, so it stays out of this
# PUBLIC repo — same rule as work_aliases.sh. Costs nothing to sync, since the home
# machine reads context-home.md instead. setup_006 creates an empty one if missing.
claude/context-work.md

# Claude Code writes permission approvals, autoMode-learned project data, theme, and
# Orca-hook rewrites back into this file constantly — that state is machine-specific
# and volatile, so it no longer syncs. Each machine keeps its own real file.
claude/settings.json
claude/settings.json.bak

