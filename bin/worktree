#!/usr/bin/env bash
#
# worktree — spin up / tear down isolated per-ticket git worktrees.
#
# Project-agnostic: run it from inside any git repo. It derives the repo name
# from the current toplevel, so a repo "foo" gets worktrees at ../foo-<slug>
# with databases foo_<slug>.
#
# Each worktree gets:
#   - its own directory (sibling of the repo) on its own branch
#   - its own node_modules (yarn/pnpm/npm install, whichever lockfile is
#     present) — skipped if no package.json
#   - its own dev + test databases (<repo>_<slug>_development and
#     <repo>_<slug>_test — same stem, environment suffix on both) via
#     bin/rails db:prepare — skipped if no bin/rails. One dev db + one test db is
#     deliberate: no parallel_tests per-worker copies are created or dropped.
#   - a per-worktree .env pinning PORT + the dev/test DB env vars (dotenv-rails
#     picks the DBs up automatically for every rails command in that worktree).
#     Seeded from the main checkout's .env when there is one: that file is normally
#     gitignored, so `git worktree add` never brings it across and a worktree would
#     otherwise start with none of the repo's local credentials. Every key except
#     the four we manage is carried over verbatim.
#   - a PORT: the ticket number from the name if usable+free (PROJ-1989 -> 1989),
#     else an auto-picked free candidate
#   - a VITE_RUBY_PORT in the same .env, always — vite.json hardcodes one dev-server
#     port for every checkout, so concurrent worktrees running bin/dev fight over it.
#     Written even for repos with no vite: one .env shape everywhere, and an env var
#     nothing reads is harmless
#
# Port pins are checked against every worktree of this repo AND every sibling
# directory of the main checkout, so a pin belonging to another project (or to an
# orphan directory git no longer tracks) still counts as taken. PORT and
# VITE_RUBY_PORT share ONE number space: both keys are read into the same set, and
# any candidate is rejected if either key pinned it anywhere.
#
# Test-DB isolation matters: in development `db:drop`/`db:create` act on BOTH the
# dev and the test database. Isolating the test DB per worktree (rather than
# sharing one <repo>_test) is what stops `worktree rm` from dropping a test DB
# that other worktrees / the main checkout are still using. For it to take
# effect, the project's database.yml `test:` section must read $TEST_DATABASE_NAME
# (or whatever WORKTREE_TEST_DB_ENV_VAR names).
#
# Config (override via env before calling):
#   WORKTREE_DB_ENV_VAR        env var database.yml reads for dev  (default: DEV_DATABASE_NAME)
#   WORKTREE_TEST_DB_ENV_VAR   env var database.yml reads for test (default: TEST_DATABASE_NAME)
#   WORKTREE_RUN_CMD           command to start the dev stack      (default: bin/dev)
#   WORKTREE_BASE_BRANCH       branch new work forks from          (default: auto-detected)
#
# Base-branch resolution (when not passed as an arg): WORKTREE_BASE_BRANCH, else origin's
# default branch as a REMOTE-tracking ref (origin/main), else local main/master. Resolving
# to origin/main rather than main is what stops a worktree inheriting a stale local trunk:
# `new` fetches first, and that moves origin/main only. A base passed as an argument is
# taken literally, so `worktree new foo 5000 main` still branches from local main.
#
# Usage:
#   worktree new <name> [port] [base-branch]   # create + set up   (base-branch default: auto-detected)
#   worktree ls                                # list worktrees (table: branch/port/db)
#   worktree rm [<name>|-i]                    # remove a worktree (menu if no name) + branch + drop db,
#                                              #   then asks separately about deleting origin/<branch>,
#                                              #   but only when every commit on it is yours
#   worktree print_path [<name>|-i]            # print a worktree's path (menu if no name); wrap to cd
#
set -euo pipefail

show_cursor() { [ -t 1 ] && printf '\033[?25h'; return 0; }   # never leave it hidden

# Set by cmd_new the moment the worktree exists on disk, so the exit hook can tell you
# what was left behind if a later setup step (bundle / db:prepare) fails and `set -e`
# takes the script out before the "✅ Ready" block.
WT_CREATED_DIR=""; WT_CREATED_NAME=""

on_exit() {
  local rc=$?          # must be the first command — captures the real exit status
  show_cursor
  if [ -n "$WT_CREATED_DIR" ] && [ "$rc" -ne 0 ]; then
    echo "" >&2
    echo "⚠ setup did not finish, but the worktree EXISTS at:" >&2
    echo "    $WT_CREATED_DIR" >&2
    echo "  its branch and .env are in place. Fix the failure above and re-run the" >&2
    echo "  failed step by hand in that directory, or tear the whole thing down:" >&2
    echo "    worktree rm $WT_CREATED_NAME" >&2
  fi
  return 0
}

# A handler that doesn't exit RESUMES the interrupted script — so the old shared
# INT/TERM trap meant Ctrl-C could restore the cursor and then carry on tearing a
# worktree down. Signals must re-raise as an exit; only EXIT is a pure cleanup hook.
trap on_exit EXIT
trap 'show_cursor; echo; echo "Interrupted." >&2; exit 130' INT
trap 'show_cursor; exit 143' TERM

# Anchor to the repo's MAIN worktree (the one holding the shared .git), NOT whichever
# worktree we happen to be standing in. Deriving from --show-toplevel would bake the
# current worktree's name into a new worktree's dir + db names whenever `new` is run
# from inside another worktree — which is exactly what leaves an orphan that `rm` run
# from elsewhere then can't find.
#
# Resolved TOLERANTLY, and every subcommand that needs a repo calls require_repo. The
# failure has to be handled here rather than left to `set -e`, because `dirname` of a
# failed substitution SUCCEEDS with ".": outside a repo this used to set MAIN=".",
# PARENT=".", REPO_NAME="." and carry on with garbage paths, after printing a bare
# "fatal: not a git repository" above the usage text.
MAIN=""; PARENT=""; REPO_NAME=""
GIT_COMMON_DIR=""
if GIT_COMMON_DIR="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" &&
   [ -n "$GIT_COMMON_DIR" ]; then
  MAIN="$(dirname "$GIT_COMMON_DIR")"
  PARENT="$(dirname "$MAIN")"
  REPO_NAME="$(basename "$MAIN")"
fi

# Where the caller's shell was when we started. `rm` uses it to notice that it is
# about to delete the directory you are standing in.
ORIG_PWD="$PWD"

require_repo() {
  [ -n "$MAIN" ] && return 0
  echo "worktree: not a git repository." >&2
  echo "  Run this from inside the repo you want a worktree of ('worktree --help' works anywhere)." >&2
  exit 1
}

DB_ENV_VAR="${WORKTREE_DB_ENV_VAR:-DEV_DATABASE_NAME}"
TEST_DB_ENV_VAR="${WORKTREE_TEST_DB_ENV_VAR:-TEST_DATABASE_NAME}"
RUN_CMD="${WORKTREE_RUN_CMD:-bin/dev}"

# Candidate ports used when no explicit port is provided. Configure these
# directly in the script; range syntax like "4000-4005" is supported.
CANDIDATE_PORTS=()
CANDIDATE_PORT_TOKENS=(3001-3100 8001-8100)
for token in "${CANDIDATE_PORT_TOKENS[@]}"; do
  if [[ "$token" =~ ^([0-9]+)-([0-9]+)$ ]]; then
    start=${BASH_REMATCH[1]}; end=${BASH_REMATCH[2]}
    if [ "$start" -le "$end" ]; then
      for ((port = start; port <= end; port++)); do
        CANDIDATE_PORTS+=("$port")
      done
    else
      for ((port = start; port >= end; port--)); do
        CANDIDATE_PORTS+=("$port")
      done
    fi
  elif [[ "$token" =~ ^[0-9]+$ ]]; then
    CANDIDATE_PORTS+=("$token")
  else
    echo "ERROR: invalid CANDIDATE_PORT_TOKENS entry: '$token'" >&2
    echo "       Use either a single port number or a range like 4000-4010." >&2
    exit 1
  fi
done

# Colours, only when stdout is a terminal (shared by the ls table + the rm menu).
if [ -t 1 ]; then
  BOLD=$'\033[1m'; DIM=$'\033[2m'; G=$'\033[32m'; Y=$'\033[33m'; R=$'\033[31m'; X=$'\033[0m'
else
  BOLD=""; DIM=""; G=""; Y=""; R=""; X=""
fi

slugify() { echo "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g'; }

# md5 hex digest of stdin. macOS ships `md5`, Linux ships `md5sum` — the digest is the
# same either way, so a db-name suffix or overmind socket path computed on one is
# reproducible on the other. Used where a SHORT deterministic hash is needed and
# `rm` must recompute the identical value at teardown.
md5_hex() {
  if command -v md5 >/dev/null 2>&1; then md5
  elif command -v md5sum >/dev/null 2>&1; then md5sum | cut -d' ' -f1
  else
    echo "ERROR: neither md5 nor md5sum found — needed for db + socket naming." >&2
    return 1
  fi
}

# Read KEY's value out of an .env file: everything after the FIRST '=', with a trailing
# CR, surrounding whitespace, a trailing ' # comment', and wrapping quotes removed —
# the same shape dotenv accepts. Echoes nothing (and still returns 0) when the file or
# the key is absent, so a bare `v="$(env_value …)"` can't trip set -e.
#
# This replaced `grep -E "^KEY=" | cut -d= -f2` everywhere, which silently truncated
# any value containing a second '=' and, worse, returned an untrimmed value that then
# failed an exact-match pin comparison — i.e. a hand-edited `PORT=3001 # rails` became
# an INVISIBLE pin, which is a duplicate port waiting to happen.
env_value() {   # file key -> value | ""
  local file="$1" key="$2" line
  [ -f "$file" ] || return 0
  line="$(grep -E "^[[:space:]]*${key}[[:space:]]*=" "$file" | tail -n1 || true)"
  [ -n "$line" ] || return 0
  line="${line#*=}"
  line="${line%$'\r'}"
  line="$(printf '%s' "$line" | sed -E 's/[[:space:]]+#.*$//')"        # trailing comment
  line="${line#"${line%%[![:space:]]*}"}"                              # ltrim
  line="${line%"${line##*[![:space:]]}"}"                              # rtrim
  case "$line" in
    \"*\") line="${line#\"}"; line="${line%\"}" ;;
    \'*\') line="${line#\'}"; line="${line%\'}" ;;
  esac
  printf '%s\n' "$line"
  return 0
}

# ---------------------------------------------------------------------------
# Claude Code context seeding
#
# Claude Code resolves two things per-DIRECTORY, so neither reaches a sibling
# worktree and both are silently lost on every ticket:
#
#   1. Auto-memory lives in ~/.claude/projects/<abs-path-slugified>/memory/. A new
#      worktree = a new absolute path = a new EMPTY memory dir that dies with the
#      branch. Measured before this was added: 43 memories in the main checkout, 0
#      across 9 worktree slugs — one of which had 11 sessions. We point every
#      worktree's memory dir at the main checkout's, so a repo has one canonical
#      memory that outlives its branches.
#
#   2. Locally-excluded context files (CLAUDE.local.md, CONTEXT.md, docs/agents/, …)
#      are untracked, so `git worktree add` never brings them across. We symlink each
#      path listed in .git/info/exclude — which lives in the shared common dir, so the
#      same list is visible from every worktree.
#
# Both are best-effort: nothing here may fail `worktree new`, hence the belt-and-braces
# `|| return 0`. Removal is the dangerous direction — see claude_unseed.
# ---------------------------------------------------------------------------

# Absolute path -> Claude Code's project-dir slug. Both '/' and '.' become '-',
# e.g. /Users/jo.smith/Projects/app -> -Users-jo-smith-Projects-app
claude_slug() { echo "$1" | sed 's#[/.]#-#g'; }

# Repo-relative paths from .git/info/exclude that are safe to symlink, one per line.
# Skips anything that isn't an unambiguous relative path present in the main checkout.
claude_excluded_paths() {
  local exclude entry
  exclude="$(git rev-parse --path-format=absolute --git-common-dir)/info/exclude"
  [ -f "$exclude" ] || return 0
  while IFS= read -r entry || [ -n "$entry" ]; do
    entry="${entry%$'\r'}"
    entry="${entry#"${entry%%[![:space:]]*}"}"   # ltrim
    entry="${entry%"${entry##*[![:space:]]}"}"   # rtrim
    case "$entry" in
      '' | '#'*) continue ;;              # blank / comment
      '!'*) continue ;;                   # negation, not a path
      /*) continue ;;                     # absolute, not repo-relative
      *'*'* | *'?'* | *'['*) continue ;;  # glob, ambiguous
      *..*) continue ;;                   # traversal
    esac
    entry="${entry%/}"                    # docs/agents/ -> docs/agents
    [ -n "$entry" ] || continue
    [ -e "$MAIN/$entry" ] || continue     # not actually present in the main checkout
    echo "$entry"
  done < "$exclude"
  return 0
}

claude_seed() {   # worktree_dir
  local dir="$1" main_mem wt_proj wt_mem entry src dst linked=0 count

  main_mem="$HOME/.claude/projects/$(claude_slug "$MAIN")/memory"
  wt_proj="$HOME/.claude/projects/$(claude_slug "$dir")"
  wt_mem="$wt_proj/memory"

  if [ -d "$main_mem" ]; then
    # Never displace a real directory — only ever create, or refresh our own symlink.
    if [ -L "$wt_mem" ] || [ ! -e "$wt_mem" ]; then
      if mkdir -p "$wt_proj" 2>/dev/null && ln -sfn "$main_mem" "$wt_mem" 2>/dev/null; then
        count="$(find "$main_mem" -maxdepth 1 -type f 2>/dev/null | wc -l | tr -d ' ')"
        echo "▶ claude memory → shared with $REPO_NAME main checkout ($count files)"
      fi
    fi
  fi

  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    src="$MAIN/$entry"
    dst="$dir/$entry"
    if [ -e "$dst" ] || [ -L "$dst" ]; then continue; fi
    mkdir -p "$(dirname "$dst")" 2>/dev/null || continue

    if [ -d "$src" ] && [ ! -L "$src" ]; then
      # A DIRECTORY entry is written as a real directory holding symlinks to its
      # children, NOT as one symlink to the directory. The exclude rule for a dir is
      # normally "docs/agents/" with a trailing slash, which git matches against
      # directories only — a symlink is not a directory to git, so a single link
      # would leave the path UNIGNORED. The worktree would then read as dirty, and
      # `worktree rm` would route every removal through its type-the-branch-name
      # "you will lose work" path. A real dir matches the rule, so the whole subtree
      # below it is ignored no matter what the children are.
      mkdir -p "$dst" 2>/dev/null || continue
      local child cdst
      for child in "$src"/* "$src"/.[!.]*; do
        [ -e "$child" ] || continue
        cdst="$dst/$(basename "$child")"
        if [ -e "$cdst" ] || [ -L "$cdst" ]; then continue; fi
        ln -sfn "$child" "$cdst" 2>/dev/null || true
      done
      linked=$((linked + 1))
    elif ln -sfn "$src" "$dst" 2>/dev/null; then
      linked=$((linked + 1))
    fi
  done < <(claude_excluded_paths)

  if [ "$linked" -gt 0 ]; then
    echo "▶ claude context → linked $linked excluded path(s) from the main checkout"
  fi
  return 0
}

# Remove what claude_seed created, BEFORE the worktree is deleted.
#
# Safety: every removal here is `rm -f` on a path first confirmed to be a SYMLINK
# (-L). Never `rm -rf`, never a path that isn't a link. The memory symlink points at
# the main checkout's real memory dir; following it would delete the repo's entire
# accumulated memory, and the excluded-path links point at the main checkout's real
# CLAUDE.local.md / CONTEXT.md / docs/. `rm -f` on a symlink unlinks the link itself
# and never touches the target — that is the whole reason this runs before, rather
# than relying on `git worktree remove --force` to do the right thing.
claude_unseed() {   # worktree_dir
  local dir="$1" wt_mem entry dst

  wt_mem="$HOME/.claude/projects/$(claude_slug "$dir")/memory"
  if [ -L "$wt_mem" ]; then
    rm -f "$wt_mem"
  fi
  # The project dir itself is left alone: it also holds this worktree's transcripts.

  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    dst="$dir/$entry"
    if [ -L "$dst" ]; then
      rm -f "$dst"
    elif [ -d "$dst" ]; then
      # Directory entries are seeded as a real dir of child symlinks (see claude_seed).
      # Unlink the children, then rmdir — which refuses if anything real is left, so a
      # file you created in there is never destroyed.
      local child
      for child in "$dst"/* "$dst"/.[!.]*; do
        if [ -L "$child" ]; then rm -f "$child"; fi
      done
      rmdir "$dst" 2>/dev/null || true
      rmdir "$(dirname "$dst")" 2>/dev/null || true   # e.g. docs/, if now empty
    fi
  done < <(claude_excluded_paths)
  return 0
}

# Ask a yes/no question; 0 if yes. Shared by the rm paths.
confirm() {   # "prompt" -> 0 if yes
  local ans; read -r -p "$1 [y/N] " ans || ans=""
  case "$ans" in [yY] | [yY][eE][sS]) return 0 ;; *) return 1 ;; esac
}

# Run a slow step with a live spinner + elapsed timer:  run_step "<label>" -- <cmd...>
# These steps (bundle/yarn/db:prepare) have no honest "% complete", so a spinner +
# seconds is the right feedback: it shows the step is alive and how long it's taking
# rather than a silent hang. The command's own chatter is captured to a temp log and
# printed ONLY if it fails — so, unlike a bare `>/dev/null`, a real error (a failed
# bundle/yarn/migrate) is surfaced instead of swallowed. No TTY (piped/CI): the
# animation is dropped and it just prints one "done (Ns)" line.
#
# stdin is /dev/null for both paths. The interactive path backgrounds the command to
# animate over it, which leaves it with no controlling terminal anyway — so anything
# that prompts (bundler asking for a credential, npm asking to authenticate) would sit
# there forever behind a cheerful spinner. Closed stdin turns that hang into an
# immediate, visible failure with the real error in the log.
SPIN=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
run_step() {
  local label="$1"; shift
  [ "${1:-}" = "--" ] && shift

  local log; log="$(mktemp -t worktree-step)"
  local start=$SECONDS rc=0

  # Non-interactive: no animation, just run, time it, and dump output on failure.
  if [ ! -t 1 ]; then
    "$@" >"$log" 2>&1 </dev/null || rc=$?
    if [ "$rc" -eq 0 ]; then
      echo "✓ $label (done, $((SECONDS - start))s)"
    else
      echo "✗ $label — FAILED (exit $rc):"; sed 's/^/    /' "$log"
    fi
    rm -f "$log"; return "$rc"
  fi

  # Interactive: animate a one-line spinner while the command runs in the background.
  "$@" >"$log" 2>&1 </dev/null &
  local pid=$! i=0
  printf '\033[?25l'                                            # hide cursor
  while kill -0 "$pid" 2>/dev/null; do
    printf '\r%s %s (%ds)\033[K' "${SPIN[i++ % ${#SPIN[@]}]}" "$label" "$((SECONDS - start))"
    sleep 0.1
  done
  wait "$pid" || rc=$?
  printf '\033[?25h'                                            # show cursor
  if [ "$rc" -eq 0 ]; then
    printf '\r✓ %s (%ds)\033[K\n' "$label" "$((SECONDS - start))"
  else
    printf '\r✗ %s (failed after %ds)\033[K\n' "$label" "$((SECONDS - start))"
    sed 's/^/    /' "$log"
  fi
  rm -f "$log"
  return "$rc"
}

# Map a slug to the database STEM. Both real db names are the stem plus an
# environment suffix, so they read symmetrically:
#   dev  = <stem>_development
#   test = <stem>_test
# PostgreSQL truncates identifiers at 63 bytes. "_development" (12 chars) is the
# longer suffix, so the stem must be <= 51 chars. The natural stem is
# <repo>_<slug-with-underscores>; when that overflows (long branch names — a slug
# of ~41+ chars does it), truncate the slug body and append an 8-char md5 of the
# FULL slug. That keeps names short, unique, and deterministic — cmd_rm recomputes
# the exact same stem, so teardown still finds the dbs. The names are ugly but the
# dir + tracked branch keep the readable full name; only the db is hashed.
db_stem_for() {   # slug -> db stem
  local slug="$1"
  local body="${slug//-/_}"
  local name="${REPO_NAME}_${body}"
  local max=51
  [ "${#name}" -le "$max" ] && { echo "$name"; return; }
  local hash; hash="$(echo -n "$slug" | md5_hex | cut -c1-8)"
  local prefix="${REPO_NAME}_"
  local keep=$(( max - ${#prefix} - 9 ))   # 9 = "_" + 8-char hash
  [ "$keep" -lt 1 ] && keep=1              # pathological: repo name alone blows the budget
  local trimmed="${body:0:keep}"; trimmed="${trimmed%_}"   # no trailing "_"
  echo "${prefix}${trimmed}_${hash}"
}

# True if <branch> exists locally or on origin.
branch_exists() {
  git show-ref --verify --quiet "refs/heads/$1" ||
    git show-ref --verify --quiet "refs/remotes/origin/$1"
}

# Pick the branch new work should fork from, in priority order:
#   1. WORKTREE_BASE_BRANCH override
#   2. origin's default branch (origin/HEAD)  3. main / master
#   4. whatever the main checkout has checked out right now
# Call after `git fetch` so remote refs are current.
resolve_base() {
  if [ -n "${WORKTREE_BASE_BRANCH:-}" ]; then echo "$WORKTREE_BASE_BRANCH"; return 0; fi
  local head
  # The remote-tracking ref, not the bare branch name: `new` fetches immediately before
  # calling this, and a fetch moves origin/main while leaving a local main days behind.
  head="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)"
  [ -n "$head" ] && { echo "$head"; return 0; }
  for b in main master; do branch_exists "$b" && { echo "$b"; return 0; }; done
  # A repo whose trunk is `develop` reaches here with no main and no master. Falling back
  # to the main checkout's own HEAD beats the old unconditional `echo main`, which handed
  # `git worktree add` a ref that doesn't exist and made it fail with
  # "fatal: invalid reference: main" — an error naming a branch the user never mentioned.
  head="$(git -C "$MAIN" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  [ -n "$head" ] && { echo "$head"; return 0; }
  echo main   # detached main checkout in a repo with no main/master: let git say so
  return 0
}

# Every directory that could be holding a port-pinning .env. Two sources, unioned:
#   1. this repo's registered worktrees (git worktree list)
#   2. every sibling directory of the main checkout ($PARENT/*)
# (2) is what makes the scan honest. (1) on its own misses two cases that have both
# happened here: a worktree belonging to a DIFFERENT repo in the same projects folder
# (invisible to this repo's `git worktree list`), and an orphan directory that still
# has a live .env but is no longer registered with git (a half-finished teardown, or
# a dir removed from git but left on disk). Either can hand you a duplicate port.
# Scanning siblings only ever makes the picker more conservative, and with 200
# candidates there is plenty of headroom to be conservative with.
pin_dirs() {
  git worktree list --porcelain | awk '/^worktree /{print $2}'
  find "$PARENT" -mindepth 1 -maxdepth 1 -type d 2>/dev/null
}

# Every port that is spoken for, as one newline-delimited set, built ONCE per run.
#
# Two things go in, and BOTH keys count for both questions:
#   1. every PORT= and VITE_RUBY_PORT= pin in every candidate dir's .env
#   2. every TCP port something is listening on right now
#
# Keying the scan per-env-var (the old `used_pins PORT` / `used_pins VITE_RUBY_PORT`)
# was a real collision: PORT and VITE_RUBY_PORT draw from ONE number space, and vite is
# derived as PORT+36, which for bases 3001-3064 lands back inside the 3001-3100
# candidate range. So `worktree new PROJ-3037` (port from the ticket number) or an
# explicit `worktree new foo 3037` passed the check while 3037 was already another
# worktree's vite dev-server port — invisible, because only `^PORT=` was ever grepped.
#
# Loading once also drops the cost from "a git + find + a grep per sibling + an lsof,
# PER CANDIDATE PORT" (hundreds of processes when the low end of the range is busy) to
# a single pass. The listener half is therefore a SNAPSHOT — call pins_reset before
# re-checking a port whose freshness matters, which is what closes the TOCTOU window
# in `new` between choosing a port and pinning it.
PIN_LIST=$'\n'
PINS_LOADED=0

pins_reset() { PINS_LOADED=0; }

load_pins() {
  [ "$PINS_LOADED" = 1 ] && return 0
  local dir key v
  PIN_LIST=$'\n'
  while read -r dir; do
    [ -f "$dir/.env" ] || continue
    for key in PORT VITE_RUBY_PORT; do
      v="$(env_value "$dir/.env" "$key")"
      [ -n "$v" ] && PIN_LIST="${PIN_LIST}${v}"$'\n'
    done
  done < <(pin_dirs | sort -u)

  # One lsof for every listening socket, rather than one per candidate. The form
  # matters: a bare `lsof -i :3001` ALSO matches outbound connections whose REMOTE
  # port is 3001, so talking to someone else's 3001 makes the port look busy.
  # -iTCP -sTCP:LISTEN restricts it to sockets actually bound here. The NAME column
  # is "*:3000 (LISTEN)" / "[::1]:3000 (LISTEN)", so take the last field that ends in
  # :<digits> rather than assuming a column number.
  while read -r v; do
    [ -n "$v" ] && PIN_LIST="${PIN_LIST}${v}"$'\n'
  done < <(lsof -nP -iTCP -sTCP:LISTEN 2>/dev/null \
             | awk '{ for (i = NF; i > 0; i--) if ($i ~ /:[0-9]+$/) { n = $i; sub(/.*:/, "", n); print n; break } }' \
             | sort -u || true)

  PINS_LOADED=1
  return 0
}

# True if <port> is pinned by either key anywhere, or is being listened on.
port_in_use() {   # port -> 0 if taken
  local p="$1"
  load_pins
  case "$PIN_LIST" in *$'\n'"$p"$'\n'*) return 0 ;; esac
  return 1
}

port_free() { ! port_in_use "$1"; }

pick_port() {
  for p in "${CANDIDATE_PORTS[@]}"; do
    port_free "$p" && { echo "$p"; return 0; }
  done
  echo "ERROR: no free candidate port" >&2; return 1
}

# vite_ruby projects hardcode one dev-server port in config/vite.json (commonly 3036),
# shared by every checkout — two worktrees running bin/dev at once fight over it. Like
# PORT/db names, this needs a per-worktree pin. vite_ruby reads VITE_RUBY_<OPTION> env
# vars as overrides (lib/vite_ruby/config.rb), so VITE_RUBY_PORT does it. Derived from
# the Rails port so the pair reads together (PORT=4000 -> VITE_RUBY_PORT=4036); if that
# candidate is taken, try a few other fixed offsets before giving up.
pick_vite_port() {   # rails_port -> vite_port
  local base="$1" offset candidate
  for offset in 36 136 236 336 436 536; do
    candidate=$((base + offset))
    [ "$candidate" -le 65535 ] && port_free "$candidate" && { echo "$candidate"; return 0; }
  done
  echo "ERROR: no free vite port near $base" >&2; return 1
}

# Derive a memorable port from the ticket number in a branch/worktree name, so
# PROJ-1989 -> http://localhost:1989. Matches the first JIRA/Linear-style
# <letters>-<digits> token (feature/PROJ-1989-i -> 1989, PROJ-123-x -> 123), and
# only when it lands in the usable unprivileged range; otherwise echoes nothing so
# the caller falls back to pick_port. Always returns 0 (keeps set -e happy).
port_from_ticket() {   # name -> port | ""
  local name="$1" num
  num="$(printf '%s' "$name" | grep -oiE '[a-z]+-[0-9]+' | head -n1 | grep -oE '[0-9]+' | head -n1)" || true
  [ -n "$num" ] || return 0
  { [ "$num" -ge 1024 ] && [ "$num" -le 65535 ]; } && echo "$num"
  return 0
}

# md5 of a path -> matches bin/dev's overmind socket hashing, so we can stop a stack.
overmind_socket_for() { echo "/tmp/overmind-$(echo "$1" | md5_hex | cut -c1-8).sock"; }

# Pick the JS install command for a worktree dir based on its lockfile, so a
# repo's actual package manager is respected instead of always assuming yarn.
# Falls back gracefully when the preferred tool isn't on PATH (e.g. a fresh
# machine with npm/corepack via mise but no standalone yarn/pnpm binary) —
# corepack shims the exact version pinned in package.json's "packageManager"
# field; if even corepack is missing, npm install is the last resort so the
# step degrades instead of hard-failing. Sets globals PM_LABEL / PM_CMD.
node_install_step() {   # dir -> sets PM_LABEL, PM_CMD
  local dir="$1"
  if [ -f "$dir/yarn.lock" ]; then
    if command -v yarn >/dev/null 2>&1; then
      PM_LABEL="yarn install"; PM_CMD=(yarn install)
    elif command -v corepack >/dev/null 2>&1; then
      PM_LABEL="corepack yarn install"; PM_CMD=(corepack yarn install)
    else
      PM_LABEL="npm install (no yarn/corepack found; yarn.lock present)"; PM_CMD=(npm install)
    fi
  elif [ -f "$dir/pnpm-lock.yaml" ]; then
    if command -v pnpm >/dev/null 2>&1; then
      PM_LABEL="pnpm install"; PM_CMD=(pnpm install)
    elif command -v corepack >/dev/null 2>&1; then
      PM_LABEL="corepack pnpm install"; PM_CMD=(corepack pnpm install)
    else
      PM_LABEL="npm install (no pnpm/corepack found; pnpm-lock.yaml present)"; PM_CMD=(npm install)
    fi
  elif [ -f "$dir/package-lock.json" ]; then
    PM_LABEL="npm ci"; PM_CMD=(npm ci)
  else
    PM_LABEL="npm install"; PM_CMD=(npm install)
  fi
}

# Write the worktree's .env: every line of the source .env EXCEPT the four keys we
# own, then our four. Source = the .env the fresh checkout already has (i.e. a TRACKED
# .env), else the main checkout's.
#
# It used to be a plain `> "$dir/.env"` truncation, which got both halves wrong. A repo
# that TRACKS a .env had it destroyed — leaving the worktree permanently modified, so
# every later `rm` was routed through the type-the-branch-name "you will lose work"
# path. And a repo whose .env is gitignored (the normal case) never had it copied at
# all: `git worktree add` doesn't carry untracked files, so the worktree started with
# none of the repo's local credentials and every rails command in it behaved
# differently from the main checkout for no visible reason.
write_env() {   # dir port vite_port db test_db
  local dir="$1" port="$2" vite_port="$3" db="$4" test_db="$5"
  local src="" tmp seeded=""
  if [ -f "$dir/.env" ]; then src="$dir/.env"
  elif [ -f "$MAIN/.env" ]; then src="$MAIN/.env"; seeded="main checkout"; fi

  tmp="$(mktemp -t worktree-env)"
  if [ -n "$src" ]; then
    grep -vE "^[[:space:]]*(PORT|VITE_RUBY_PORT|${DB_ENV_VAR}|${TEST_DB_ENV_VAR})[[:space:]]*=" \
      "$src" > "$tmp" || true
    # A source file with no final newline would otherwise swallow our first key.
    [ -s "$tmp" ] && [ -n "$(tail -c1 "$tmp")" ] && echo >> "$tmp"
  fi
  {
    echo "PORT=$port"; echo "VITE_RUBY_PORT=$vite_port"
    echo "$DB_ENV_VAR=$db"; echo "$TEST_DB_ENV_VAR=$test_db"
  } >> "$tmp"
  cat "$tmp" > "$dir/.env"    # copy, not mv: keeps the checkout's own file mode
  rm -f "$tmp"

  [ -n "$seeded" ] && echo "▶ .env      : seeded from the $seeded, with our 4 keys overridden"
  # A tracked .env is now modified rather than clobbered, which is the best available
  # outcome — but say so, because it makes the worktree read as dirty from birth.
  if git -C "$dir" ls-files --error-unmatch .env >/dev/null 2>&1; then
    echo "${Y}⚠ this repo TRACKS .env — our 4 keys are written into it, so the worktree${X}"
    echo "${Y}  will show .env as modified. Commit or discard it as you would any change.${X}"
  fi
  return 0
}

# 0 when <dir> exists and holds nothing besides <allowed> — used to decide whether
# git's collapsed "?? vendor/" entry is purely our own artifact or is hiding real work.
dir_holds_only() {   # dir allowed_name
  local d="$1" allow="$2"
  [ -d "$d" ] || return 1
  [ -z "$(find "$d" -mindepth 1 -maxdepth 1 ! -name "$allow" -print -quit 2>/dev/null)" ]
}

# Count the uncommitted changes in <dir> that are actually YOURS.
#
# `git status --porcelain` counts untracked files, and three of the things it finds are
# ours, created by `worktree new` itself: .env, .bundle/config and vendor/bundle/. Unless
# the user had separately added them to ~/.gitignore_global, a pristine worktree
# therefore reported 1-3 "uncommitted changes", set ASSESS_RISKY=1, and made every
# routine teardown demand the branch name be typed — which is exactly how a real
# warning gets trained into noise. Only the UNTRACKED forms are discounted; a tracked
# .env or .bundle/config that has been modified is real work and still counts.
dirty_count() {   # dir -> count
  local dir="$1" pat='\.env|\.bundle/config|vendor/bundle/'
  # git collapses a wholly-untracked directory into one "?? vendor/" entry, so accept
  # that form only when the directory holds nothing but our artifact.
  dir_holds_only "$dir/.bundle" config && pat="$pat|\.bundle/"
  dir_holds_only "$dir/vendor"  bundle && pat="$pat|vendor/"
  git -C "$dir" status --porcelain 2>/dev/null | grep -cvE "^\?\? ($pat)\$" || true
}

cmd_new() {
  require_repo
  local name="${1:?usage: worktree new <name> [port] [base-branch]}"
  local slug; slug="$(slugify "$name")"
  local dir="$PARENT/${REPO_NAME}-$slug"
  local stem; stem="$(db_stem_for "$slug")"
  local db="${stem}_development"
  local test_db="${stem}_test"

  # Port: an explicit arg wins; otherwise reuse the ticket number as the port
  # (memorable — the preview URL then matches the ticket) when it's usable and
  # free, else auto-pick a free candidate from CANDIDATE_PORTS.
  local port="${2:-}" port_src="explicit"
  if [ -n "$port" ]; then
    # An explicit port is still checked. It used to be taken purely on trust, so
    # `worktree new foo 3002` would cheerfully pin a port another worktree already
    # owned — the one path that skipped every collision check. Fail up front,
    # before anything is created, rather than hand out a known duplicate.
    if ! [[ "$port" =~ ^[0-9]+$ ]] || [ "$port" -lt 1024 ] || [ "$port" -gt 65535 ]; then
      echo "ERROR: '$port' is not a usable port (want 1024-65535)." >&2; exit 1
    fi
    if ! port_free "$port"; then
      echo "ERROR: port $port is already pinned by another worktree, or something is" >&2
      echo "       listening on it. Run 'worktree ls' to see the pins, or omit the" >&2
      echo "       port argument to auto-pick a free one." >&2
      exit 1
    fi
  else
    local ticket_port; ticket_port="$(port_from_ticket "$name")"
    if [ -n "$ticket_port" ] && port_free "$ticket_port"; then
      port="$ticket_port"; port_src="from ticket number"
    else
      port="$(pick_port)"; port_src="auto-picked"
      [ -n "$ticket_port" ] && port_src="auto-picked ($ticket_port from ticket is in use)"
    fi
  fi

  # VITE_RUBY_PORT is pinned for EVERY repo, not just ones with a config/vite.json
  # sitting there today. vite_ruby hardcodes one dev-server port shared by every
  # checkout, so concurrent worktrees running bin/dev fight over it; VITE_RUBY_PORT
  # is the documented override. Writing it unconditionally keeps a single .env shape
  # across every repo and machine — a repo that doesn't use vite just carries an env
  # var nothing reads, which costs nothing and cannot clash with anything. It also
  # means the key is present everywhere, so the pin scan sees a consistent picture.
  # Depends on $port above, so compute it after the port block.
  local vite_port; vite_port="$(pick_vite_port "$port")"

  # Refresh remote-tracking refs so an existing origin branch is detected
  # (tolerant: don't fail the command if offline or there's no origin).
  echo "▶ fetching origin..."
  git fetch --quiet origin 2>/dev/null || true

  # Resolve after the fetch so origin/HEAD and remote branches are current.
  local base="${3:-$(resolve_base)}"

  echo "▶ worktree : $dir"
  echo "▶ branch   : $name (from $base)"
  echo "▶ database : $db  (via \$$DB_ENV_VAR)"
  echo "▶ test db  : $test_db  (via \$$TEST_DB_ENV_VAR)"
  echo "▶ port     : $port  ($port_src)"
  echo "▶ vite port: $vite_port  (via \$VITE_RUBY_PORT — vite.json hardcodes one for every checkout)"

  # Gate: spell out exactly what will happen, then let the user back out before
  # anything is created. Steps are conditional on what the repo actually has.
  local env_line="write .env (PORT + VITE_RUBY_PORT + $DB_ENV_VAR + $TEST_DB_ENV_VAR)"
  [ -f "$MAIN/.env" ] && env_line="$env_line, seeded from the main checkout's .env"
  echo "▶ steps    :"
  echo "    - create worktree + branch at the paths above"
  echo "    - $env_line"
  local claude_n; claude_n="$(claude_excluded_paths | wc -l | tr -d ' ')"
  if [ -d "$HOME/.claude/projects/$(claude_slug "$MAIN")/memory" ] || [ "$claude_n" -gt 0 ]; then
    echo "    - link claude context (shared memory + $claude_n excluded path(s))"
  fi
  if [ -f "$MAIN/package.json" ]; then
    node_install_step "$MAIN"
    echo "    - $PM_LABEL"
  fi
  [ -f "$MAIN/Gemfile" ]      && echo "    - bundle install into vendor/bundle (gems isolated from the shared gem home)"
  [ -x "$MAIN/bin/rails" ]    && echo "    - bin/rails db:prepare (creates dbs $db + $test_db)"
  echo ""
  # Close the check-to-use gap (TOCTOU). Nothing RESERVES the port chosen above, and
  # the origin fetch between there and here can take seconds — long enough for a
  # second `worktree new` in another tab to check the same number, agree it is free,
  # and pin it. Both were right at the time; both then pin it.
  #
  # pins_reset is what makes the re-check mean anything: the pin + listener scan is
  # cached after its first use (see load_pins), so without dropping the cache this
  # re-reads the same snapshot and always agrees.
  pins_reset
  if ! port_free "$port"; then
    if [ "$port_src" = "explicit" ]; then
      echo "⚠ port $port was claimed during setup — pinning it anyway," >&2
      echo "  since you asked for it by name. Expect a clash." >&2
    else
      local stolen="$port"
      port="$(pick_port)"
      port_src="re-picked ($stolen was claimed during setup)"
      echo "▶ port reassigned: $stolen → $port  ($stolen went to something else during setup)"
    fi
  fi
  if ! port_free "$vite_port"; then
    local stolen_vite="$vite_port"
    vite_port="$(pick_vite_port "$port")"
    echo "▶ vite port reassigned: $stolen_vite → $vite_port"
  fi

  # Drop admin entries for worktrees whose directory is gone (deleted by hand, or a
  # half-finished teardown). Without this, `git worktree add` at a path git still has
  # registered fails with "missing but already registered worktree" — after the
  # confirmation and port selection, which is the most annoying moment to find out.
  git worktree prune

  if git show-ref --verify --quiet "refs/heads/$name"; then
    # Existing local branch — check it out (base-branch arg is ignored).
    echo "▶ using existing local branch"
    git worktree add "$dir" "$name"
  elif git show-ref --verify --quiet "refs/remotes/origin/$name"; then
    # Exists on origin but not locally — create a local tracking branch.
    echo "▶ tracking existing origin/$name"
    git worktree add "$dir" -b "$name" --track "origin/$name"
  else
    # Brand new branch off the base.
    echo "▶ creating new branch from $base"
    # --no-track: branch.autoSetupMerge defaults to setting an upstream when the start
    # point is a remote-tracking ref, which would make `git pull` here pull main.
    git worktree add --no-track -b "$name" "$dir" "$base"
  fi

  # From here on the worktree EXISTS, so a failure in any step below leaves something
  # behind. Tell the exit hook what, so `set -e` can't walk out silently.
  WT_CREATED_DIR="$dir"; WT_CREATED_NAME="$name"

  write_env "$dir" "$port" "$vite_port" "$db" "$test_db"

  # Before the slow steps, so the worktree is usable by Claude even if a later
  # bundle/db step fails and you fix it by hand.
  claude_seed "$dir"

  if [ -f "$dir/package.json" ]; then
    node_install_step "$dir"
    ( cd "$dir" && run_step "$PM_LABEL" -- "${PM_CMD[@]}" )
  fi

  # Isolate this worktree's gems from the shared mise gem home. Multiple worktrees
  # share one Ruby gem dir but each has its own Gemfile.lock, so a default/transitive
  # gem bumped on one branch breaks the others with "already activated X, but your
  # Gemfile requires Y" — e.g. one branch bumped erb and every other worktree's
  # bin/rails blew up on load. A per-worktree vendor/bundle fixes it: the bundle path
  # goes to .bundle/config (already gitignored by the repo), but the vendor/bundle/
  # dir the gems install into is NOT — adding `vendor/bundle/` to your global gitignore
  # (~/.gitignore_global) keeps it out of everyone else's status output. `rm` no longer
  # NEEDS you to have done that: dirty_count discounts these paths while they are
  # untracked, so an un-ignored vendor/bundle can't flag a clean worktree as risky.
  # Must run before db:prepare — once isolated, bin/rails needs gems installed here.
  #
  # DOCKER INTERACTION — worth knowing if the project's dev stack runs in a container:
  #   A compose stack that bind-mounts the whole worktree (.:/app) and keeps gems in a
  #   named volume is SAFE at runtime alongside this isolation. The ruby image sets
  #   BUNDLE_APP_CONFIG, so the container reads its bundler config from there and
  #   IGNORES the bind-mounted /app/.bundle/config — BUNDLE_PATH:vendor/bundle never
  #   takes effect inside the container, and gems still load from the volume.
  #   The one cost is at BUILD time, and only if the project's .dockerignore doesn't
  #   exclude .bundle/ and vendor/ while its Dockerfile does `COPY . /app`: building an
  #   image FROM a worktree then drags the host's vendor/bundle (hundreds of MB of
  #   macOS gems) into the build context — bloat and slower builds, never a broken
  #   image. Adding /.bundle and /vendor/bundle to that project's .dockerignore fixes
  #   it, and is worth doing for everyone working in the repo, not just worktree users.
  if [ -f "$dir/Gemfile" ]; then
    ( cd "$dir" && bundle config set --local path 'vendor/bundle' >/dev/null )   # instant, no spinner
    ( cd "$dir" && run_step "isolating gems (vendor/bundle) + bundle install" -- bundle install )
  fi

  if [ -x "$dir/bin/rails" ]; then
    ( cd "$dir" && run_step "db:prepare ($db + $test_db)" -- \
        env "$DB_ENV_VAR=$db" "$TEST_DB_ENV_VAR=$test_db" bin/rails db:prepare )
  fi

  echo ""
  echo "✅ Ready. Start it with:"
  echo "     cd $dir && $RUN_CMD"
  echo "   (PORT $port and DB '$db' are automatic via .env; app on http://localhost:$port; vite dev server on $vite_port)"
}

cmd_ls() {
  require_repo
  # One vertical block per worktree instead of one wide row. Long branch/db names
  # blow out a horizontal table — every column widens to its longest cell, so a
  # single 60-char db name shoves everything sideways. Here each field is its own
  # line: a fixed-width label on the left, the value free to run as long as it likes
  # on the right. Blocks are separated by a rule; the WORKTREE line is the title.
  local -a NAME BRANCH PORT VPORT DB TDB
  NAME=(); BRANCH=(); PORT=(); VPORT=(); DB=(); TDB=()

  # Parse the porcelain stream block-by-block: each worktree is a `worktree <path>`
  # line followed by `branch refs/heads/<name>` (or `detached`), blank-separated.
  local wt="" br=""
  while IFS= read -r line; do
    case "$line" in
      "worktree "*) wt="${line#worktree }" ;;
      "branch "*)   br="${line#branch refs/heads/}" ;;
      "detached")   br="(detached)" ;;
      "")           [ -n "$wt" ] && ls_row "$wt" "$br"; wt=""; br="" ;;
    esac
  done < <(git worktree list --porcelain; echo)   # trailing blank flushes the last block

  local n="${#NAME[@]}"
  if [ "$n" -eq 0 ]; then echo; echo "No worktrees."; echo; return; fi

  # Fixed label column = widest label; the between-block rule spans label + gap +
  # the longest value across every field, so it never looks stubby or overruns.
  local -a LABELS=("WORKTREE" "BRANCH" "PORT" "VITE PORT" "DEV DB" "TEST DB")
  local lw=0 l; for l in "${LABELS[@]}"; do (( ${#l} > lw )) && lw=${#l}; done
  local maxval=0 i v
  for i in "${!NAME[@]}"; do
    for v in "${NAME[$i]}" "${BRANCH[$i]}" "${PORT[$i]}" "${VPORT[$i]}" "${DB[$i]}" "${TDB[$i]}"; do
      (( ${#v} > maxval )) && maxval=${#v}
    done
  done
  local rule; rule="$(printf '%.0s─' $(seq 1 $(( lw + 2 + maxval ))))"

  echo
  for i in "${!NAME[@]}"; do
    printf "${BOLD}%-${lw}s  %s${X}\n" "${LABELS[0]}" "${NAME[$i]}"      # title row (bold)
    printf "${DIM}%-${lw}s${X}  %s\n"  "${LABELS[1]}" "${BRANCH[$i]}"
    printf "${DIM}%-${lw}s${X}  %s\n"  "${LABELS[2]}" "${PORT[$i]}"
    printf "${DIM}%-${lw}s${X}  %s\n"  "${LABELS[3]}" "${VPORT[$i]}"
    printf "${DIM}%-${lw}s${X}  %s\n"  "${LABELS[4]}" "${DB[$i]}"
    printf "${DIM}%-${lw}s${X}  %s\n"  "${LABELS[5]}" "${TDB[$i]}"
    [ "$i" -lt "$((n - 1))" ] && printf "${DIM}%s${X}\n" "$rule"        # separator, not after last
  done
  echo
}

# Append one worktree's cells to the parallel ls arrays. Shows the dir basename
# (the full path is redundant — every worktree is a sibling of the repo) and reads
# the pinned PORT / vite port / dev db / test db from the worktree's .env ("-" when
# absent — e.g. the main checkout, or a worktree predating a given key).
ls_row() {   # dir branch
  local dir="$1" branch="${2:--}" port="-" vport="-" db="-" test_db="-"
  if [ -f "$dir/.env" ]; then
    # env_value handles the missing-key case (echoes nothing, returns 0), so the
    # ${var:--} fallback is all that's needed to turn that into a "-".
    port="$(env_value "$dir/.env" PORT)";                     port="${port:--}"
    vport="$(env_value "$dir/.env" VITE_RUBY_PORT)";           vport="${vport:--}"
    db="$(env_value "$dir/.env" "$DB_ENV_VAR")";               db="${db:--}"
    test_db="$(env_value "$dir/.env" "$TEST_DB_ENV_VAR")";     test_db="${test_db:--}"
  fi
  NAME+=("$(basename "$dir")"); BRANCH+=("$branch"); PORT+=("$port"); VPORT+=("$vport"); DB+=("$db"); TDB+=("$test_db")
}

# Refresh origin so the merged/pushed assessment is current, avoiding false 'risky'
# flags from stale origin/* refs. Called once per rm invocation (not per worktree).
# Tolerant: offline or no origin just proceeds with whatever refs are already local.
fetch_origin() {
  echo "${DIM}▶ fetching origin…${X}" >&2
  git fetch --quiet origin 2>/dev/null || true
}

# The ref to test "is this branch already merged?" against — first that exists.
# origin/* are local mirrors updated by fetch, so this is network-free (and may be
# stale; a stale miss just makes us over-cautious, which is the safe direction).
#
# Echoes nothing and STILL RETURNS 0 when none of them resolve. The trailing `return 0`
# is load-bearing: without it the function inherited the last failed `git rev-parse`'s
# status, and every caller assigns it bare (`main="$(mainline_ref)"`), which under
# `set -e` killed the whole script. In a repo whose trunk is `develop` — no main, no
# master, no origin/main — that made `worktree rm` exit 1 after printing only
# "▶ fetching origin…", with no error and nothing removed. Callers all handle an
# empty result already; they were never given the chance to.
mainline_ref() {
  local c
  for c in origin/main origin/master main master; do
    git rev-parse --verify --quiet "$c" >/dev/null && { echo "$c"; return 0; }
  done
  return 0
}

# Assess whether removing <dir>/<branch> would lose work. Sets globals:
#   ASSESS_RISKY (0|1)  ASSESS_SHA  ASSESS_BRANCH_NOTE  ASSESS_WORK_NOTE
# Risky = the branch has commits neither merged into mainline nor pushed to origin,
# OR the working tree has uncommitted changes (which --force would discard).
assess_removal() {   # dir branch
  local dir="$1" branch="$2"
  ASSESS_RISKY=0; ASSESS_SHA=""; ASSESS_BRANCH_NOTE=""; ASSESS_WORK_NOTE=""
  local main; main="$(mainline_ref)"   # "" in a repo with no main/master — handled below
  [ -n "$branch" ] && ASSESS_SHA="$(git rev-parse --verify --quiet "$branch" 2>/dev/null || true)"

  if [ -z "$branch" ]; then
    ASSESS_BRANCH_NOTE="${DIM}detached HEAD${X}"
  elif [ -n "$main" ] && git merge-base --is-ancestor "$ASSESS_SHA" "$main" 2>/dev/null; then
    ASSESS_BRANCH_NOTE="${G}merged into ${main#origin/}${X}"
  elif git rev-parse --verify --quiet "origin/$branch" >/dev/null 2>&1; then
    local ahead; ahead="$(git rev-list --count "origin/$branch..$ASSESS_SHA" 2>/dev/null || echo 0)"
    if [ "$ahead" = 0 ]; then
      ASSESS_BRANCH_NOTE="${G}pushed to origin${X}"
    else
      ASSESS_BRANCH_NOTE="${R}$ahead commit(s) not pushed — would be lost${X}"; ASSESS_RISKY=1
    fi
  else
    if [ -n "$main" ]; then
      local only; only="$(git rev-list --count "$main..$ASSESS_SHA" 2>/dev/null || echo '?')"
      ASSESS_BRANCH_NOTE="${R}not on origin — $only commit(s) only here${X}"
    else
      ASSESS_BRANCH_NOTE="${R}not on origin — would be lost${X}"
    fi
    ASSESS_RISKY=1
  fi

  local dirty; dirty="$(dirty_count "$dir" | tr -d ' ')"
  if [ "${dirty:-0}" -gt 0 ]; then
    ASSESS_WORK_NOTE="${R}$dirty uncommitted change(s) — would be discarded${X}"; ASSESS_RISKY=1
  else
    ASSESS_WORK_NOTE="${G}clean${X}"
  fi
}

# Populate WT_* parallel arrays with every worktree EXCEPT the main checkout.
# Feeds the interactive rm menu and the print_path picker. WT_BRANCH is kept for
# assess_removal (merged/pushed check), even though the picker no longer shows it.
gather_worktrees() {   # [all] — pass "all" to include the main checkout (marked via WT_ISMAIN)
  local include_main="${1:-}"
  WT_DIR=(); WT_BRANCH=(); WT_ISMAIN=()
  local wt="" br=""
  while IFS= read -r line; do
    case "$line" in
      "worktree "*) wt="${line#worktree }" ;;
      "branch "*)   br="${line#branch refs/heads/}" ;;
      "detached")   br="" ;;
      "")
        if [ -n "$wt" ]; then
          local ismain=0; [ "$wt" = "$MAIN" ] && ismain=1
          if [ "$ismain" = 0 ] || [ "$include_main" = all ]; then
            WT_DIR+=("$wt"); WT_BRANCH+=("$br"); WT_ISMAIN+=("$ismain")
          fi
        fi
        wt=""; br="" ;;
    esac
  done < <(git worktree list --porcelain; echo)
}

# Render the gathered worktrees (WT_* arrays) as a numbered, column-sized table like
# `ls`. mode=rm adds a risk dot + coloured STATE column (from assess_removal);
# mode=plain omits it. STATE is the trailing column, so its colour codes never break
# alignment.
print_picker() {   # mode: rm|plain
  local mode="$1" i
  local -a NUM NAME STATE
  NUM=("#"); NAME=("WORKTREE"); STATE=("STATE")
  for i in "${!WT_DIR[@]}"; do
    local nm; nm="$(basename "${WT_DIR[$i]}")"
    [ "${WT_ISMAIN[$i]:-0}" = 1 ] && nm="$nm (main)"
    NUM+=("$((i + 1))"); NAME+=("$nm")
    if [ "$mode" = rm ]; then
      # STATE carries the branch's status (merged/pushed/would-be-lost + detached),
      # which is why the picker doesn't also need a BRANCH column of its own.
      assess_removal "${WT_DIR[$i]}" "${WT_BRANCH[$i]}"
      local dot="${G}●${X}"; [ "$ASSESS_RISKY" = 1 ] && dot="${R}▲${X}"
      STATE+=("$dot $ASSESS_BRANCH_NOTE${DIM} · ${X}$ASSESS_WORK_NOTE")
    fi
  done

  # Widths of the plain-text columns (STATE is coloured + last, so left free).
  local -a W=(0 0)
  for i in "${!NUM[@]}"; do
    (( ${#NUM[$i]}  > W[0] )) && W[0]=${#NUM[$i]}
    (( ${#NAME[$i]} > W[1] )) && W[1]=${#NAME[$i]}
  done
  local fmt="  %-${W[0]}s  %-${W[1]}s"
  [ "$mode" = rm ] && fmt="$fmt  %s"
  fmt="$fmt\n"
  local rule; rule="$(printf '%.0s─' $(seq 1 $(( W[0] + W[1] + 4 ))))"

  # ${X} goes inside the format, before fmt's trailing \n — appended after it, the reset
  # landed on the next line and the header's bold bled into the rule below it.
  local hdr_fmt="${BOLD}${fmt%'\n'}${X}\n"   # fmt's newline is a literal \n for printf
  if [ "$mode" = rm ]; then
    printf "$hdr_fmt" "${NUM[0]}" "${NAME[0]}" "${STATE[0]}"
  else
    printf "$hdr_fmt" "${NUM[0]}" "${NAME[0]}"
  fi
  printf "  ${DIM}%s${X}\n" "$rule"
  for i in "${!NUM[@]}"; do
    [ "$i" = 0 ] && continue
    if [ "$mode" = rm ]; then
      printf "$fmt" "${NUM[$i]}" "${NAME[$i]}" "${STATE[$i]}"
    else
      printf "$fmt" "${NUM[$i]}" "${NAME[$i]}"
    fi
  done
}

# Resolve a name to a worktree via git's OWN list, echoing "<dir>\t<branch>". Matches
# the arg against the branch name, the directory basename, or the <repo>-<slug>
# convention — so it still works when run from a different worktree than created it
# (which changes REPO_NAME, and thus any recomputed path), or when the dir and branch
# names have diverged. The main checkout never matches. Non-zero if nothing matched.
resolve_worktree() {   # query -> "<dir>\t<branch>"
  local query="$1" slug; slug="$(slugify "$query")"
  local conv_base="${REPO_NAME}-$slug"
  local wt="" br=""
  while IFS= read -r line; do
    case "$line" in
      "worktree "*) wt="${line#worktree }" ;;
      "branch "*)   br="${line#branch refs/heads/}" ;;
      "detached")   br="" ;;
      "")
        if [ -n "$wt" ] && [ "$wt" != "$MAIN" ]; then
          local base; base="$(basename "$wt")"
          if [ "$br" = "$query" ] || [ "$base" = "$query" ] || [ "$base" = "$conv_base" ]; then
            printf '%s\t%s\n' "$wt" "$br"; return 0
          fi
        fi
        wt=""; br="" ;;
    esac
  done < <(git worktree list --porcelain; echo)
  return 1
}

# Tear down one already-resolved worktree: confirm, stop its stack, drop its dev+test
# dbs (names read from the worktree's own .env — authoritative), remove the worktree,
# delete its branch, and report ONLY what actually happened. Returns 1 if declined.
remove_worktree() {   # dir branch
  local dir="$1" branch="$2"

  # Stand in the MAIN checkout for the whole teardown. `git worktree remove` will
  # happily delete the directory you are standing in, and every git call after that
  # dies on "Unable to read current working directory" — so running `worktree rm` from
  # inside the worktree being removed (the obvious way to finish a ticket) used to
  # delete the directory, then FAIL to delete the branch (falling through to the
  # "delete it manually" message) and silently skip the origin question entirely,
  # because its `git rev-parse … || return 0` guard can't tell an unreadable cwd from
  # "origin doesn't have this branch". Every path below is absolute, so moving is free.
  cd "$MAIN"

  local db test_db
  db="$(env_value "$dir/.env" "$DB_ENV_VAR")"
  test_db="$(env_value "$dir/.env" "$TEST_DB_ENV_VAR")"
  # Fallback when the worktree has no .env: recompute from the dir name. The dir is
  # "<repo>-<slug>", so strip the repo prefix first — db_stem_for adds it back.
  local stem=""
  if [ -z "$db" ] || [ -z "$test_db" ]; then
    local base; base="$(basename "$dir")"
    stem="$(db_stem_for "$(slugify "${base#"${REPO_NAME}-"}")")"
  fi
  [ -n "$db" ]      || db="${stem}_development"
  [ -n "$test_db" ] || test_db="${stem}_test"

  assess_removal "$dir" "$branch"
  echo
  echo "▶ worktree : $dir"
  echo "▶ branch   : ${branch:-(detached)}  ${DIM}·${X} $ASSESS_BRANCH_NOTE"
  echo "▶ state    : $ASSESS_WORK_NOTE"
  echo "▶ databases: $db + $test_db"

  # Namesake drift: a worktree "<repo>-<slug>" normally has the branch whose slug
  # matches <slug> checked out. If you've since switched it to another branch (e.g.
  # a deploy/… branch to push a preview), everything above describes THAT branch, and
  # removal deletes it — while the branch the worktree was created for is left behind.
  # Flag it so you don't delete blind or assume the namesake branch went with it.
  local namesake; namesake="$(basename "$dir")"; namesake="${namesake#"${REPO_NAME}-"}"
  if [ -n "$branch" ] && [ "$(slugify "$branch")" != "$namesake" ]; then
    echo "${Y}⚠ on '$branch', not this worktree's namesake ('$namesake') — removing deletes '$branch'; the namesake branch (if it still exists) is left as-is.${X}"
  fi

  if [ "$ASSESS_RISKY" = 1 ]; then
    echo "${R}▲ Removing this will permanently lose the work flagged above.${X}"
    local target="${branch:-$(basename "$dir")}" ans
    read -r -p "Type '$target' to confirm removal, or Enter to abort: " ans || ans=""
    [ "$ans" = "$target" ] || { echo "Aborted."; return 1; }
  else
    confirm "Remove this worktree, delete the branch, and drop these dbs?" || { echo "Aborted."; return 1; }
  fi

  if command -v overmind >/dev/null 2>&1; then
    echo "▶ stopping stack (if running)..."
    OVERMIND_SOCKET="$(overmind_socket_for "$dir")" overmind quit 2>/dev/null || true
    sleep 1
  else
    # Only overmind is known here (its socket path is a hash of the worktree dir). Any
    # other process manager has to be stopped by hand, and if the app is still holding
    # a connection the db drop below will fail and say so.
    echo "${DIM}▶ overmind not installed — skipping stack stop (stop it yourself if it's running)${X}"
  fi
  if [ -x "$dir/bin/rails" ]; then
    echo "▶ dropping databases $db + $test_db..."
    # Both dev + test are isolated to this worktree, so db:drop (which in
    # development targets both) can't reach a shared test DB.
    ( cd "$dir" && env "$DB_ENV_VAR=$db" "$TEST_DB_ENV_VAR=$test_db" bin/rails db:drop >/dev/null 2>&1 ) \
      || echo "  (db drop skipped/failed - drop manually: dropdb '$db'; dropdb '$test_db')"
  else
    echo "  (no bin/rails at $dir — skipping db drop; if needed: dropdb '$db'; dropdb '$test_db')"
  fi
  # Unlink the Claude symlinks first. `git worktree remove --force` recursively
  # deletes the directory, and these links point at the main checkout's real
  # CLAUDE.local.md / CONTEXT.md / docs/ — unlink them ourselves rather than rely on
  # the delete doing the right thing near live files. See claude_unseed.
  claude_unseed "$dir"
  echo "▶ removing worktree..."
  git worktree remove "$dir" --force
  if [ -n "$branch" ]; then
    git branch -D "$branch" 2>/dev/null || echo "  (couldn't delete branch '$branch' - delete it manually)"
  fi
  echo "${G}✅ removed worktree${X}${branch:+, branch '$branch',} and dbs ($db, $test_db)"
  # Log + print a one-paste restore for the branch ref (its commits survive in the
  # object store until git gc, so this recreates the branch pointing at the same tip).
  if [ -n "$branch" ] && [ -n "$ASSESS_SHA" ]; then
    printf '%s  %s  %s\n' "$(date '+%F %T')" "$branch" "$ASSESS_SHA" >> "$MAIN/.git/worktree-removed.log" 2>/dev/null || true
    echo "${DIM}   restore the branch if needed:  git branch '$branch' $ASSESS_SHA${X}"
  fi

  # Your shell is a different process, so its cwd can't be changed from here — but if it
  # was sitting in the directory just deleted, every command you type next fails with a
  # confusing "no such file or directory". Say so, and hand over the way out.
  case "$ORIG_PWD" in
    "$dir" | "$dir"/*)
      echo "${Y}⚠ your shell is still inside the directory that was just removed.${X}"
      echo "${Y}  run:  cd $MAIN${X}"
      ;;
  esac

  # Local teardown is done and reported. Now — and only now — ask about origin.
  maybe_delete_remote_branch "$branch"
}

# The ref a branch's own commits are measured against. mainline_ref covers main/master;
# fall back to origin's default branch, because a repo whose trunk is `develop` has no
# main/master ref at all and would otherwise leave the "range" as the entire history.
# Echoes nothing — and still returns 0 — when neither resolves, so a bare
# `x="$(branch_base_ref)"` can't trip set -e.
branch_base_ref() {
  local m b
  m="$(mainline_ref || true)"
  if [ -n "$m" ]; then echo "$m"; return 0; fi
  b="$(resolve_base || true)"
  b="${b#origin/}"
  if [ -n "$b" ]; then
    git rev-parse --verify --quiet "origin/$b" >/dev/null 2>&1 && { echo "origin/$b"; return 0; }
    git rev-parse --verify --quiet "$b"        >/dev/null 2>&1 && { echo "$b";        return 0; }
  fi
  return 0
}

# The gate on remote deletion: is origin/<branch> yours to delete?
#
# git attributes commits, never refs — nothing records who pushed a branch into
# existence — so authorship of the commits it carries is the honest proxy for "I
# created this". Echoes a reason (naming the first author who isn't you) and returns 1
# when the branch carries anyone else's work; stays silent and returns 0 only when
# every commit is yours.
#
# Which commits are judged: the ones origin/<branch> adds on top of the trunk. When
# that range is EMPTY the branch is fully merged — its commits now live in the trunk's
# own history, where no range can isolate them — so the tip commit is judged instead,
# which for a merged PR branch is the author's last commit. With no trunk ref at all,
# the branch's entire history is judged rather than guessing at a range.
#
# Every failure answers "not yours": no user.email configured, no readable commits, an
# unreadable ref. One-way by design — there is no flag, env var, or prompt that turns
# a refusal here into a deletion.
remote_branch_foreign_author() {   # branch -> "" + 0 (yours) | "<author>" + 1 (not yours)
  local branch="$1" me="" base="" list="" author lower
  me="$(git config user.email 2>/dev/null | tr '[:upper:]' '[:lower:]' || true)"
  [ -n "$me" ] || { echo "no git user.email is set here, so no branch can be established as yours"; return 1; }

  base="$(branch_base_ref)"
  if [ -n "$base" ]; then
    list="$(git log --format='%aE' "$base..origin/$branch" 2>/dev/null || true)"
    [ -n "$list" ] || list="$(git log -1 --format='%aE' "origin/$branch" 2>/dev/null || true)"
  else
    list="$(git log --format='%aE' "origin/$branch" 2>/dev/null || true)"
  fi
  [ -n "$list" ] || { echo "no commits could be read from origin/$branch, so its authorship is unknown"; return 1; }

  while IFS= read -r author; do
    [ -n "$author" ] || continue
    lower="$(printf '%s' "$author" | tr '[:upper:]' '[:lower:]')"
    [ "$lower" = "$me" ] || { echo "it carries commits by $author"; return 1; }
  done <<< "$list"
  return 0
}

# Offer to delete the branch on origin too, once local teardown has succeeded.
# Deliberately a SEPARATE question, asked after the fact: the local removal is
# recoverable (the commits survive in the object store, and the restore command is
# printed above), whereas `git push origin --delete` touches the shared remote and
# takes out anything else pointing at it — an open PR's branch, a colleague's
# checkout base. So it's never folded into the removal confirmation and never
# implied by it. Only asked when origin actually has the branch, judged from the
# origin/* mirror that fetch_origin refreshed at the top of cmd_rm.
#
# And only asked at all for a branch whose commits are all yours — see
# remote_branch_foreign_author. Removing a worktree is a housekeeping act on YOUR
# machine; deleting someone else's branch off the shared remote is not, and no
# amount of confirming makes it a thing this command should do. When the branch
# isn't yours the question is never put, and the manual command is printed instead
# so the decision moves to you, deliberately, outside this script.
#
# The local branch is already gone by now, so merged-ness is assessed against
# origin/<branch> directly rather than reusing ASSESS_BRANCH_NOTE (which described
# the now-deleted local ref).
maybe_delete_remote_branch() {   # branch
  local branch="$1"
  [ -n "$branch" ] || return 0
  git rev-parse --verify --quiet "refs/remotes/origin/$branch" >/dev/null 2>&1 || return 0

  local main note; main="$(mainline_ref)"   # "" when the repo has no main/master
  if [ -n "$main" ] && git merge-base --is-ancestor "origin/$branch" "$main" 2>/dev/null; then
    note="${G}merged into ${main#origin/}${X}"
  elif [ -n "$main" ]; then
    local ahead; ahead="$(git rev-list --count "$main..origin/$branch" 2>/dev/null || echo '?')"
    note="${R}not merged into ${main#origin/} — $ahead commit(s) ahead${X}"
  else
    note="${Y}merge status unknown (no mainline ref found)${X}"
  fi

  echo
  echo "▶ remote   : origin/$branch still exists  ${DIM}·${X} $note"

  local foreign
  if ! foreign="$(remote_branch_foreign_author "$branch")"; then
    echo "${Y}⛔ leaving origin/$branch alone — $foreign${X}"
    echo "${DIM}   worktree only offers to delete remote branches whose commits are all yours."
    echo "   if it really is yours to remove:  git push origin --delete '$branch'${X}"
    return 0
  fi

  confirm "Also delete the remote branch origin/$branch?" || {
    echo "${DIM}   left origin/$branch alone — delete it later with:  git push origin --delete '$branch'${X}"
    return 0
  }

  echo "▶ deleting origin/$branch..."
  if git push --quiet origin --delete "$branch"; then
    echo "${G}✅ deleted remote branch origin/$branch${X}"
  else
    echo "  (couldn't delete origin/$branch — delete it manually: git push origin --delete '$branch')"
  fi
}

# Interactive picker: list the worktrees (numbered), remove the chosen one, then loop
# with a refreshed list until you quit. Reached by `worktree rm` with no name (or -i).
interactive_rm() {
  while :; do
    gather_worktrees
    local n="${#WT_DIR[@]}"
    if [ "$n" -eq 0 ]; then
      echo; echo "No removable worktrees — only the main checkout ($MAIN) remains."; return 0
    fi
    print_picker rm
    echo "  ${G}●${X}${DIM} safe · ${R}▲${X}${DIM} risky (unpushed commits / uncommitted changes) · ${BOLD}q${X}${DIM} quit${X}"
    local sel; read -r -p "› remove which? " sel || sel="q"
    case "$sel" in
      q | Q | "") echo "Done."; return 0 ;;
      *[!0-9]* | 0) echo "  ${Y}enter a number from the list, or q${X}" ;;
      *)
        if [ "$sel" -le "$n" ]; then
          remove_worktree "${WT_DIR[$((sel - 1))]}" "${WT_BRANCH[$((sel - 1))]}" || true
        else
          echo "  ${Y}$sel is out of range (1-$n)${X}"
        fi
        ;;
    esac
  done
}

cmd_rm() {
  require_repo
  fetch_origin   # once, up front, so every assessment below sees current origin/* refs

  # No name (or -i) → interactive menu; otherwise resolve the given name directly.
  if [ $# -eq 0 ] || [ "${1:-}" = "-i" ] || [ "${1:-}" = "--interactive" ]; then
    interactive_rm; return
  fi

  local resolved; resolved="$(resolve_worktree "$1")" || {
    echo "✗ no worktree matches '$1' — nothing removed."
    echo "  Run 'worktree ls', or 'worktree rm' with no name to pick from a menu."
    git worktree prune   # tidy any stale admin entries while we're here
    return 1
  }
  remove_worktree "${resolved%%$'\t'*}" "${resolved#*$'\t'}"
}

# Print the directory of a chosen worktree, so a shell wrapper can cd into it (a script
# can't change the parent shell's dir itself). Only the chosen PATH goes to stdout; the
# menu + prompts go to stderr — that's what lets `cd "$(worktree print_path)"` work. With a
# NAME it resolves directly (the main checkout included); with none (or -i) it shows an
# interactive picker of ALL worktrees.
cmd_print_path() {
  require_repo
  if [ $# -gt 0 ] && [ "$1" != "-i" ] && [ "$1" != "--interactive" ]; then
    if [ "$1" = "$(basename "$MAIN")" ] || [ "$1" = main ]; then printf '%s\n' "$MAIN"; return 0; fi
    local resolved; resolved="$(resolve_worktree "$1")" || { echo "✗ no worktree matches '$1'." >&2; return 1; }
    printf '%s\n' "${resolved%%$'\t'*}"; return 0
  fi

  gather_worktrees all
  local n="${#WT_DIR[@]}"
  [ "$n" -eq 0 ] && { echo "No worktrees." >&2; return 1; }
  print_picker plain >&2
  printf "  ${DIM}%s${X}\n" "q  quit" >&2
  local sel; read -r -p "› which worktree? " sel || sel="q"
  case "$sel" in
    q | Q | "")   return 1 ;;
    *[!0-9]* | 0) echo "  not a number." >&2; return 1 ;;
    *) if [ "$sel" -le "$n" ]; then printf '%s\n' "${WT_DIR[$((sel - 1))]}"; else echo "  out of range (1-$n)." >&2; return 1; fi ;;
  esac
}

# Printed when called with no/unknown args or -h/--help. Keep this the single
# source of truth for "how do I call this" — subcommand list, args, examples.
usage() {
  cat <<'EOF'
worktree — spin up / tear down isolated per-ticket git worktrees.

Run from inside any git repo. Each worktree gets its own directory, branch,
node_modules, dev + test databases, and a free port — so tickets don't collide.

USAGE
  worktree <command> [args]

COMMANDS
  new <name> [port] [base-branch]
      Create a worktree at ../<repo>-<name> on branch <name>, with its own dev +
      test databases (<repo>_<name>_development and <repo>_<name>_test),
      node_modules, and a
      per-worktree .env pinning PORT + VITE_RUBY_PORT + the DB env vars. That .env
      is seeded from the main checkout's .env when there is one — it's normally
      gitignored, so git can't bring it across — with those four keys overridden
      and every other key carried over.
      Prints its plan, then runs it — there is no confirmation prompt. If
      <name> already exists (locally or on origin) it's checked out; otherwise
      it's created from [base-branch].
        port         optional; defaults to the ticket number in <name> (PROJ-1989
                     -> 1989) when that's a usable free port, else auto-picked.
                     A port you pass explicitly is checked too — if it's already
                     pinned or listening, the command fails instead of clashing.
                     Pins are read from every worktree of this repo AND every
                     sibling dir of the main checkout, so other projects count,
                     and PORT + VITE_RUBY_PORT share one number space.
        base-branch  optional; defaults to origin's default branch as a remote-tracking
                     ref (origin/main) so a stale local main is never inherited, else
                     local main/master. Pass `main` explicitly to branch from local main.
      e.g.  worktree new PROJ-123-fix-header
            worktree new PROJ-123-fix-header 5000
            worktree new hotfix 5000 main

  ls
      List all worktrees, one vertical block each: branch, pinned port, vite port,
      dev db, and test db ("-" for anything the .env doesn't pin) — a block per
      worktree, so long db/branch names stay readable instead of blowing out a row.
      e.g.  worktree ls

  rm [<name> | -i]
      With a NAME: resolve it (by branch name, directory name, or <repo>-<slug>),
      then — after a confirmation — stop its stack, drop its dev + test databases,
      remove the worktree, and delete its branch. With NO name (or -i): pick from
      an interactive numbered menu that re-lists after each removal until you quit.
      Safe to run from INSIDE the worktree being removed; it warns you to cd out.
      Safeguards: a branch with commits neither merged into mainline nor pushed to
      origin, or a worktree with uncommitted changes, is flagged (▲) and needs the
      branch name typed to confirm. The untracked files worktree itself created
      (.env, .bundle/config, vendor/bundle/) don't count as uncommitted changes.
      A restore command for the branch is printed and
      logged to <main>/.git/worktree-removed.log.
      Once the local teardown has succeeded, and only if origin still has the branch,
      it asks as a separate question whether to delete origin/<branch> too (defaults
      to no, and shows whether that branch is merged into mainline first).
      That question is only ever put for a branch whose commits are ALL authored by
      you (your git user.email). A remote branch carrying anyone else's commits is
      left alone and the manual `git push origin --delete` is printed instead — there
      is no flag or prompt that overrides it. Local teardown is unaffected.
      e.g.  worktree rm PROJ-123-fix-header
            worktree rm                     # interactive menu

  print_path [<name> | -i]
      Print the directory of a worktree (with a NAME) or pick one from an interactive
      menu (no name). Prints ONLY the path to stdout, so wrap it in a shell function
      to cd there — a script can't change your shell's directory itself:
          wt() { local d; d="$(worktree print_path "$@")" && cd "$d"; }
      Then:  wt              # menu, then cd into the choice
             wt PROJ-1989    # cd straight there

CONFIG (override via env before calling)
  WORKTREE_DB_ENV_VAR        env var database.yml reads for dev  (default: DEV_DATABASE_NAME)
  WORKTREE_TEST_DB_ENV_VAR   env var database.yml reads for test (default: TEST_DATABASE_NAME)
  WORKTREE_RUN_CMD           command to start the dev stack      (default: bin/dev)
  WORKTREE_BASE_BRANCH       branch new work forks from          (default: auto-detected)
EOF
}

case "${1:-}" in
  new)              shift; cmd_new "$@" ;;
  ls)               cmd_ls ;;
  rm)               shift; cmd_rm "$@" ;;
  print_path)       shift; cmd_print_path "$@" ;;
  -h | --help | help) usage ;;
  "")               usage; exit 1 ;;
  *)                echo "worktree: unknown command '$1'" >&2; echo >&2; usage >&2; exit 1 ;;
esac
