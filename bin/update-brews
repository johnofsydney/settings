#!/usr/bin/env bash
#
# update-brews — install/update the Homebrew apps, callable from anywhere.
#
# A memorable name for setup_scripts/setup_001_install_apps.sh, which is where
# the actual work lives. All this does is find that file relative to itself and
# hand over to it, arguments and all.
#
# NOTE: this is the one command in bin/ that is deliberately NOT standalone — it
# only works from inside a checkout of the settings repo, because the script it
# runs is part of that repo. That is the whole point of it, so it is an accepted
# exception to the self-containment rule in NOTES.md rather than a defect.
#
# Usage:
#   update-brews          # run the app install/update
#   update-brews <args>   # anything you pass is forwarded to the setup script
#
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
SETUP_SCRIPT="$REPO_ROOT/setup_scripts/setup_001_install_apps.sh"

# Expected to be present. If it isn't, say what was being looked for and why,
# rather than leaving a bare path and a non-zero exit to interpret.
if [[ ! -f "$SETUP_SCRIPT" ]]; then
  cat >&2 <<EOF
update-brews: nothing to run — the setup script is missing.

  expected at: $SETUP_SCRIPT

update-brews is only a wrapper; the work lives in the settings repo alongside it.
It looks for setup_scripts/ one level up from its own location, so this means
either the file has moved or been renamed, or this copy of update-brews has been
taken out of the settings repo and is on its own.

  repo: github.com:johnofsydney/settings
EOF
  exit 1
fi

exec "$SETUP_SCRIPT" "$@"
